{
	"name": "@niijima/design",
	"version": "0.1.0",
	"description": "The Niijima Network's shared look: tokens, fonts, components and the Makoto/Sae persona switch.",
	"type": "module",
	"license": "MIT",
	"repository": "github:sopika2/Niijima-Design",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./svelte": {
			"types": "./dist/svelte/index.d.ts",
			"svelte": "./dist/svelte/index.js",
			"default": "./dist/svelte/index.js"
		},
		"./niijima.css": "./dist/css/niijima.css",
		"./tokens.css": "./dist/css/tokens.css",
		"./components.css": "./dist/css/components.css",
		"./fonts.css": "./dist/fonts/fonts.css"
	},
	"sideEffects": [
		"**/*.css"
	],
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		}
	},
	"scripts": {
		"build": "svelte-package -i src/lib -o dist",
		"prepare": "svelte-package -i src/lib -o dist",
		"dev": "vite demo",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test": "vitest run",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"verify": "pnpm lint && pnpm check && pnpm test && pnpm build && publint"
	},
	"devDependencies": {
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.12",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "~6.0.3",
		"vite": "^8.3.5",
		"vitest": "^4.1.12"
	},
	"packageManager": "pnpm@10.28.0"
}
